<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Reads the Wi-Fi IP shown by the wireless debugging tile. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to query GitHub releases and download updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to prompt Android package installer for seamless in-place updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Caffeine: a foreground service holds a screen wake lock while it is on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- QR scanner. Asked for the first time the scanner opens; only used while it is open. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Screen Time: allows reading foreground usage time for the user-selected app. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Public Mode: overlay to block restricted private apps from opening. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Public Mode: silence incoming notifications and previews while device is handed over. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Android 13+ runtime notification permission for foreground services. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Switchly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Long-pressing one of our tiles opens its config screen. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
            </intent-filter>
        </activity>

        <service
            android:name=".tiles.QrScannerTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_scan"
            android:label="@string/tile_qr_scanner"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Opened by the Payment QR tile; its own task so it never brings the main app along. -->
        <activity
            android:name=".payments.PaymentQrActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/QrTheme" />

        <!-- Opened by the Scan QR tile and the app. -->
        <activity
            android:name=".scanner.ScannerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/QrTheme" />

        <!-- Opened by the Quick texts tile; transparent dialog activity for reliable display on MIUI and all OEMs. -->
        <activity
            android:name=".texts.QuickTextsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/TransparentDialogActivityTheme" />

        <!-- Quick Settings tiles. Keep in sync with tiles/TileRegistry.kt. -->
        <service
            android:name=".tiles.PrivateDnsTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_dns"
            android:label="@string/tile_private_dns"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.GrayscaleTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_grayscale"
            android:label="@string/tile_grayscale"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <!-- API 33+: announced as an on/off switch by accessibility services. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.AnimationSpeedTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_speed"
            android:label="@string/tile_animation_speed"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.WirelessDebuggingTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_adb"
            android:label="@string/tile_wireless_debugging"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.KillSwitchTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_block"
            android:label="@string/tile_kill_switch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.ProfileTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_profiles"
            android:label="@string/tile_profiles"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.QuickTextsTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_texts"
            android:label="@string/tile_quick_texts"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Not an active tile: re-renders on every panel open so the date rolls over. -->
        <service
            android:name=".tiles.BsDateTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_calendar"
            android:label="@string/tile_bs_date"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tiles.PaymentQrTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_qr"
            android:label="@string/tile_payment_qr"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Not an active tile: reads fresh values each time the panel opens. -->
        <service
            android:name=".tiles.BatteryTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_battery"
            android:label="@string/tile_battery"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- App Screen Time Slots 1 to 4: reads fresh usage stats each time the panel opens. -->
        <service
            android:name=".tiles.AppScreenTimeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_app_screen_time_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tiles.AppScreenTimeTile2"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_app_screen_time_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tiles.AppScreenTimeTile3"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_app_screen_time_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tiles.AppScreenTimeTile4"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_app_screen_time_4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tiles.FontSizeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_font"
            android:label="@string/tile_font_size"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.CaffeineTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_coffee"
            android:label="@string/tile_caffeine"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".power.CaffeineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the screen on for a user-chosen time after the user taps the Caffeine Quick Settings tile." />
        </service>

        <service
            android:name=".tiles.PublicModeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_public_mode"
            android:label="@string/tile_public_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <!-- Bound only on tap or refresh; see tiles/TileRefresher.kt. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".publicmode.PublicModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors foreground apps to block private apps and manages timeout while Public Mode is active." />
        </service>

        <!-- Re-pushes tile state after an app update; SystemUI keeps the old state otherwise. -->
        <receiver
            android:name=".tiles.TileUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Kill switch: a local VPN that drops all traffic. -->
        <service
            android:name=".network.KillSwitchVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>
        <!-- FileProvider to safely grant the system package installer access to downloaded update APKs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Lists launchable apps for the kill switch exceptions (no QUERY_ALL_PACKAGES). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
