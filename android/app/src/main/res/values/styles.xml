<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown from tap until Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI; the app background colour so there is no flash after the splash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
    <!-- Payment QR screen: full screen and dark from the first frame, so the QR appears instantly. -->
    <style name="QrTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
