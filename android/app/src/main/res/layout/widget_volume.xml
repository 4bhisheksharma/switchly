<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_volume"
            android:contentDescription="Volume" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Volume Control" />

        <TextView
            android:id="@+id/widget_volume_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8D8B9D"
            android:textSize="11sp"
            android:text="Sound On" />
    </LinearLayout>

    <!-- Volume Percentage Headline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="26sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="80%" />

        <TextView
            android:id="@+id/widget_volume_stream_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#C4C2D6"
            android:textSize="13sp"
            android:text="Media Loudness" />
    </LinearLayout>

    <!-- Flexible spacer between headline and preset chips -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Preset Chips Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_volume_preset_mute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:textColor="#C4C2D6"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="3dp"
            android:text="Mute" />

        <TextView
            android:id="@+id/widget_volume_preset_30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:textColor="#C4C2D6"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="30%" />

        <TextView
            android:id="@+id/widget_volume_preset_70"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:textColor="#C4C2D6"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="70%" />

        <TextView
            android:id="@+id/widget_volume_preset_100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:textColor="#C4C2D6"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="3dp"
            android:text="Max" />
    </LinearLayout>
</LinearLayout>
