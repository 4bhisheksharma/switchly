<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg_dark"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_volume"
            android:contentDescription="Volume" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Volume" />

        <TextView
            android:id="@+id/widget_volume_stream_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8D8B9D"
            android:textSize="10sp"
            android:text="Media" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/widget_volume_btn_down"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="#818CF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="80%" />

        <TextView
            android:id="@+id/widget_volume_btn_up"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_volume_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8D8B9D"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Sound On" />
</LinearLayout>
