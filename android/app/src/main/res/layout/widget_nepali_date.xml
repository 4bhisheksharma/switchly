<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_day_container"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/widget_day_badge"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_bs_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:text="१" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_bs_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="बैशाख २०८१" />

        <TextView
            android:id="@+id/widget_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#C4C2D6"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="आइतबार" />

        <TextView
            android:id="@+id/widget_ad_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8D8B9D"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Sun, 14 Apr 2024" />
    </LinearLayout>
</LinearLayout>

