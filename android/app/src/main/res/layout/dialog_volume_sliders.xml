<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_volume"
            android:contentDescription="Volume" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="Volume Loudness" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dialog_volume_ringer_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Sound On" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- 1. Media Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Media (Music &amp; Video)" />

        <TextView
            android:id="@+id/dialog_volume_media_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="80%" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/dialog_volume_media_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:splitTrack="false"
        android:progressTint="#4F46E5"
        android:thumbTint="#818CF8"
        android:progressBackgroundTint="#2E3142"
        android:max="100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <!-- 2. Ringtone Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Ringtone (Calls)" />

        <TextView
            android:id="@+id/dialog_volume_ring_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="70%" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/dialog_volume_ring_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:splitTrack="false"
        android:progressTint="#4F46E5"
        android:thumbTint="#818CF8"
        android:progressBackgroundTint="#2E3142"
        android:max="100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <!-- 3. Notifications Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Notifications" />

        <TextView
            android:id="@+id/dialog_volume_notif_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="70%" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/dialog_volume_notif_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:splitTrack="false"
        android:progressTint="#4F46E5"
        android:thumbTint="#818CF8"
        android:progressBackgroundTint="#2E3142"
        android:max="100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <!-- 4. Alarm Volume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Alarm" />

        <TextView
            android:id="@+id/dialog_volume_alarm_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#818CF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="100%" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/dialog_volume_alarm_seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:splitTrack="false"
        android:progressTint="#4F46E5"
        android:thumbTint="#818CF8"
        android:progressBackgroundTint="#2E3142"
        android:max="100" />

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/dialog_volume_btn_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System UI"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#818CF8" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/dialog_volume_btn_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#C4C2D6" />

        <Button
            android:id="@+id/dialog_volume_btn_done"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="18dp"
            android:background="@drawable/btn_primary_rounded"
            android:text="Done"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>

